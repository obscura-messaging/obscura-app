# iOS / CocoaPods
#
ios/Pods/
ios/build/
ios/.xcode.env.local
*.xcuserstate
xcuserdata/
# Xcode auto-generates this workspace inside the .xcodeproj; the real workspace
# is ios/Obscura.xcworkspace (CocoaPods). Don't track the generated one.
ios/*.xcodeproj/project.xcworkspace/

# vendor
#
vendor/

# node.js
#
node_modules/
npm-debug.log
yarn-error.log

# Bundle artifact
*.jsbundle

# Firebase — project-specific config, fetch from Firebase console per env
android/app/google-services.json
ios/**/GoogleService-Info.plist
gha-creds-*.json
*.p12
*.mobileprovision
AuthKey_*.p8

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Jest coverage output
/coverage

# Native kit build outputs
kotlin/.gradle/
kotlin/build/
kotlin/lib/build/
swift/.build/
swift/.swiftpm/
protocol/**/__pycache__/

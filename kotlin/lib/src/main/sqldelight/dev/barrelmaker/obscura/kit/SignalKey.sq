CREATE TABLE IF NOT EXISTS SignalLocalIdentity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1 CHECK (id = 1),
    identity_key_pair BLOB NOT NULL,
    registration_id INTEGER NOT NULL
);

-- The trusted identity key of each peer account, keyed by user id.
CREATE TABLE IF NOT EXISTS SignalIdentity (
    user_id TEXT NOT NULL PRIMARY KEY,
    identity_key BLOB NOT NULL
);

-- One-time EC pre-keys. A key is stale once a newer batch replaces it on the server; stale keys
-- still decrypt messages already in flight and are deleted after a while (see SignalStore).
CREATE TABLE IF NOT EXISTS SignalPreKey (
    id INTEGER NOT NULL PRIMARY KEY,
    record BLOB NOT NULL,
    stale_at INTEGER NOT NULL DEFAULT 0
);

-- Signed EC pre-keys. The record carries its creation time.
CREATE TABLE IF NOT EXISTS SignalSignedPreKey (
    id INTEGER NOT NULL PRIMARY KEY,
    record BLOB NOT NULL
);

-- Kyber pre-keys: one-time keys and last-resort keys share one id space, as in libsignal's store.
CREATE TABLE IF NOT EXISTS SignalKyberPreKey (
    id INTEGER NOT NULL PRIMARY KEY,
    record BLOB NOT NULL,
    last_resort INTEGER NOT NULL,
    stale_at INTEGER NOT NULL DEFAULT 0
);

-- Each (last-resort Kyber key, signed pre-key, sender base key) a session was started with. A
-- repeat is a replayed first message, which libsignal rejects through markKyberPreKeyUsed.
CREATE TABLE IF NOT EXISTS SignalLastResortKeyUse (
    kyber_id INTEGER NOT NULL,
    signed_id INTEGER NOT NULL,
    base_key BLOB NOT NULL,
    PRIMARY KEY (kyber_id, signed_id, base_key)
);

-- Which signed and last-resort keys this device has published, the next id of each kind, and when
-- it last rotated and synced, like Signal-Android's PreKeyMetadataStore. The two keys rotate
-- together. Ids wrap at Medium.MAX_VALUE.
CREATE TABLE IF NOT EXISTS SignalPreKeyState (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1 CHECK (id = 1),
    next_signed_id INTEGER NOT NULL,
    next_one_time_id INTEGER NOT NULL,
    next_kyber_id INTEGER NOT NULL,
    active_signed_id INTEGER NOT NULL,
    active_last_resort_id INTEGER NOT NULL,
    rotated_at INTEGER NOT NULL,
    synced_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS SignalSession (
    address TEXT NOT NULL PRIMARY KEY,
    record BLOB NOT NULL
);

selectLocalIdentity:
SELECT * FROM SignalLocalIdentity WHERE id = 1;

insertLocalIdentity:
INSERT OR REPLACE INTO SignalLocalIdentity(id, identity_key_pair, registration_id) VALUES (1, ?, ?);

deleteLocalIdentity:
DELETE FROM SignalLocalIdentity;

selectIdentityByUser:
SELECT identity_key FROM SignalIdentity WHERE user_id = ?;

insertIdentity:
INSERT OR REPLACE INTO SignalIdentity(user_id, identity_key) VALUES (?, ?);

deleteAllIdentities:
DELETE FROM SignalIdentity;

selectPreKey:
SELECT record FROM SignalPreKey WHERE id = ?;

insertPreKey:
INSERT OR REPLACE INTO SignalPreKey(id, record) VALUES (?, ?);

deletePreKey:
DELETE FROM SignalPreKey WHERE id = ?;

countPreKeys:
SELECT COUNT(*) FROM SignalPreKey;

markPreKeysStale:
UPDATE SignalPreKey SET stale_at = :now WHERE stale_at = 0;

-- Stale before :cutoff, except the :keep most recent keys (fresh first, then latest stale).
deleteStalePreKeys:
DELETE FROM SignalPreKey
WHERE stale_at > 0 AND stale_at < :cutoff AND id NOT IN (
    SELECT id FROM SignalPreKey
    ORDER BY CASE stale_at WHEN 0 THEN 1 ELSE 0 END DESC, stale_at DESC, id DESC
    LIMIT :keep
);

deleteAllPreKeys:
DELETE FROM SignalPreKey;

selectSignedPreKey:
SELECT record FROM SignalSignedPreKey WHERE id = ?;

selectAllSignedPreKeys:
SELECT record FROM SignalSignedPreKey;

insertSignedPreKey:
INSERT OR REPLACE INTO SignalSignedPreKey(id, record) VALUES (?, ?);

deleteSignedPreKey:
DELETE FROM SignalSignedPreKey WHERE id = ?;

deleteAllSignedPreKeys:
DELETE FROM SignalSignedPreKey;

selectKyberPreKey:
SELECT record FROM SignalKyberPreKey WHERE id = ?;

selectAllKyberPreKeys:
SELECT record FROM SignalKyberPreKey;

selectLastResortKyberPreKeys:
SELECT record FROM SignalKyberPreKey WHERE last_resort = 1;

isLastResortKyberPreKey:
SELECT last_resort FROM SignalKyberPreKey WHERE id = ?;

insertKyberPreKey:
INSERT OR REPLACE INTO SignalKyberPreKey(id, record, last_resort) VALUES (?, ?, ?);

deleteKyberPreKey:
DELETE FROM SignalKyberPreKey WHERE id = ?;

deleteOneTimeKyberPreKey:
DELETE FROM SignalKyberPreKey WHERE id = ? AND last_resort = 0;

markKyberPreKeysStale:
UPDATE SignalKyberPreKey SET stale_at = :now WHERE stale_at = 0 AND last_resort = 0;

deleteStaleKyberPreKeys:
DELETE FROM SignalKyberPreKey
WHERE last_resort = 0 AND stale_at > 0 AND stale_at < :cutoff AND id NOT IN (
    SELECT id FROM SignalKyberPreKey WHERE last_resort = 0
    ORDER BY CASE stale_at WHEN 0 THEN 1 ELSE 0 END DESC, stale_at DESC, id DESC
    LIMIT :keep
);

deleteAllKyberPreKeys:
DELETE FROM SignalKyberPreKey;

hasLastResortKeyUse:
SELECT EXISTS(SELECT 1 FROM SignalLastResortKeyUse WHERE kyber_id = ? AND signed_id = ? AND base_key = ?);

insertLastResortKeyUse:
INSERT INTO SignalLastResortKeyUse(kyber_id, signed_id, base_key) VALUES (?, ?, ?);

deleteLastResortKeyUses:
DELETE FROM SignalLastResortKeyUse WHERE kyber_id = ?;

deleteAllLastResortKeyUses:
DELETE FROM SignalLastResortKeyUse;

selectPreKeyState:
SELECT * FROM SignalPreKeyState WHERE id = 1;

insertPreKeyState:
INSERT OR REPLACE INTO SignalPreKeyState(
    id, next_signed_id, next_one_time_id, next_kyber_id, active_signed_id, active_last_resort_id, rotated_at, synced_at
) VALUES (1, ?, ?, ?, ?, ?, ?, ?);

deletePreKeyState:
DELETE FROM SignalPreKeyState;

selectSession:
SELECT record FROM SignalSession WHERE address = ?;

insertSession:
INSERT OR REPLACE INTO SignalSession(address, record) VALUES (?, ?);

deleteSession:
DELETE FROM SignalSession WHERE address = ?;

deleteSessionsByPrefix:
DELETE FROM SignalSession WHERE address LIKE ?;

deleteSessionsOfUser:
DELETE FROM SignalSession WHERE address IN (SELECT device_id || '.1' FROM Device WHERE user_id = ?);

deleteAllSessions:
DELETE FROM SignalSession;
